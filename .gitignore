# -----------------------------
# Python cache/build artifacts
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------
# Virtual environments
# -----------------------------
.venv/
venv/
env/

# -----------------------------
# Secrets and local configuration
# -----------------------------
.env
*.env
config.local.*
secrets.*
*.pem
*.key

# -----------------------------
# Raw crawl databases
# Keep OpenWPM SQLite/database outputs out of Git.
# -----------------------------
*.sqlite
*.sqlite3
*.db

# -----------------------------
# Logs and temporary files
# -----------------------------
*.log
*.tmp
*.temp

# -----------------------------
# OS/editor files
# -----------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# -----------------------------
# OpenWPM/Docker/runtime artifacts
# These should stay in the OpenWPM environment, not this repo.
# -----------------------------
docker-volume/
screenshots/
browser-profiles/
crawl-data/
tmp/
temp/

# -----------------------------
# Data and Results Management
# -----------------------------
# Ignore everything in data/ EXCEPT the output tree
data/*
!data/output_tree.csv

# Ignore everything in results/ EXCEPT the sample_run folder
results/*
!results/sample_run/
!results/sample_run/**

# Ignore accidental root-level CSV outputs
/*.csv

# Git transfer artifacts
server_work.bundle
*.bundle
